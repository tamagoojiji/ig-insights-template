# VPS一時バックフィル用の環境変数
# このファイルを vps-backfill.env にコピーして値を記入してください
# .gitignore 済み（公開リポジトリにコミットされません）

# IG長期アクセストークン（接続テスト後の60日トークン）
TOKEN=

# IGビジネスアカウントID（設定シート行5の値）
USER_ID=

# 任意: 別のSSHホストを使う場合
# SSH_HOST=vps

# 任意: 出力先パスを指定する場合（デフォルト /tmp/ig-backfill-{epoch}.json）
# OUT_FILE=/tmp/ig-backfill.json
