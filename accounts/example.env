# 1アカウント1ファイル。実ファイルは private リポ ig-insights-accounts/accounts/<id>.env に置く（このリポには置かない）
# 秘密値（アクセスキー・トークン・FBシークレット）は書かない。アクセスキーは Mac Keychain（KEYCHAIN のサービス名）
ID=example                       # 英小文字。/ig/<ID>/・ig-bsuite-<ID>・localStorage キー ig_k_<ID> に使う
TITLE="example インサイト"        # 画面の表示名
GAS_SCRIPT_ID=                   # GAS スクリプトID（push-gas.sh）
GAS_DEPLOY_ID=                   # Web App の既存デプロイID（/exec）
SHEET_ID=                        # 保存先スプレッドシート
URL_PATH=/ig/example/            # 利用者に渡す URL のパス
BUSINESS_ID=                     # Business Suite の business_id（巡回）
ASSET_ID=                        # Business Suite の asset_id（巡回）
KEYCHAIN=ig-app-key-example      # アクセスキーの Keychain サービス名
